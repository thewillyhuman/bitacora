load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("//src/rust:defs.bzl", "bitacora_integration_test", "bitacora_library")

exports_files(["Cargo.toml"])

# Runs build.rs, which turns the protocol definitions into Rust code. Cargo
# runs the same script, so both builds generate the same code, and neither
# needs a protoc binary: the script compiles the definitions itself.
cargo_build_script(
    name = "generated_protocol",
    srcs = ["build.rs"],
    data = ["//src/proto:protocol_files"],
    edition = "2024",
    deps = all_crate_deps(build = True),
)

bitacora_library(
    name = "bitacora_proto",
    # The unit tests hold the transport's size limits to the size of a batch
    # frame, which the segment crate defines.
    test_deps = ["//src/rust/bitacora-segment:bitacora_segment"],
    deps = [
        ":generated_protocol",
        "//src/rust/bitacora-types:bitacora_types",
    ],
)

# A real replica served over gRPC on the loopback interface.
bitacora_integration_test(
    name = "replica_transport_test",
    srcs = [
        "tests/replica_transport_test.rs",
        "tests/support/mod.rs",
    ],
    crate_root = "tests/replica_transport_test.rs",
    deps = [
        ":bitacora_proto",
        "//src/rust/bitacora-artifact:bitacora_artifact",
        "//src/rust/bitacora-replica:bitacora_replica",
        "//src/rust/bitacora-segment:bitacora_segment",
        "//src/rust/bitacora-types:bitacora_types",
    ],
)

# A writer, a reader and a takeover on three replicas served over gRPC.
bitacora_integration_test(
    name = "cluster_transport_test",
    srcs = [
        "tests/cluster_transport_test.rs",
        "tests/support/mod.rs",
    ],
    crate_root = "tests/cluster_transport_test.rs",
    deps = [
        ":bitacora_proto",
        "//src/rust/bitacora-client:bitacora_client",
        "//src/rust/bitacora-meta:bitacora_meta",
        "//src/rust/bitacora-replica:bitacora_replica",
        "//src/rust/bitacora-segment:bitacora_segment",
        "//src/rust/bitacora-types:bitacora_types",
    ],
)
