load("//src/rust:defs.bzl", "bitacora_binary")

exports_files(["Cargo.toml", "example.toml"])

bitacora_binary(
    name = "bita-replica",
    srcs = glob(["src/**/*.rs"]),
    # A test checks the metrics the daemon exposes against their reference,
    # and another one parses the example configuration.
    test_data = [
        "example.toml",
        "//docs:operations/metrics.md",
    ],
    deps = [
        "//src/rust/bitacora",
        "//src/rust/bitacora-artifact:bitacora_artifact",
        "//src/rust/bitacora-meta:bitacora_meta",
        "//src/rust/bitacora-process:bitacora_process",
        "//src/rust/bitacora-proto:bitacora_proto",
        "//src/rust/bitacora-replica:bitacora_replica",
        "//src/rust/bitacora-segment:bitacora_segment",
        "//src/rust/bitacora-types:bitacora_types",
    ],
)
