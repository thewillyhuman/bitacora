load("@rules_go//go:def.bzl", "go_library", "go_test")

# The replica service of docs/protocol/wire.md, from the caller's side:
# typed requests, typed refusals, one connection per replica.
go_library(
    name = "replica",
    srcs = ["replica.go"],
    importpath = "github.com/thewillyhuman/bitacora/src/go/internal/replica",
    visibility = ["//src/go:__subpackages__"],
    deps = [
        "//src/go/internal/frame",
        "//src/go/internal/wire",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//backoff",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
    ],
)

go_test(
    name = "replica_test",
    size = "small",
    srcs = ["replica_test.go"],
    embed = [":replica"],
    deps = [
        "//src/go/internal/frame",
        "//src/go/internal/wire",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//metadata",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(["*.go"]),
    visibility = ["//src/go:__pkg__"],
)
