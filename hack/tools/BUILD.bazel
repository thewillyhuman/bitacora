"""Pinned programs that the tests of scripts and deployment files run.

//:MODULE.bazel fetches one release of each per platform, by checksum. The
aliases here pick the one for the platform at hand, and fail with a clear
message on any other.
"""

exports_files([
    "rejection_test.sh",
    "shellcheck_test.sh",
])

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

_NO_PINNED_RELEASE = "no release of this program is pinned for this platform; add one in //:MODULE.bazel"

# shellcheck, which lints every shell script of the repository.
alias(
    name = "shellcheck",
    actual = select(
        {
            ":linux_arm64": "@shellcheck_linux_arm64//:shellcheck",
            ":linux_x86_64": "@shellcheck_linux_x86_64//:shellcheck",
            ":macos_arm64": "@shellcheck_macos_arm64//:shellcheck",
        },
        no_match_error = _NO_PINNED_RELEASE,
    ),
    visibility = ["//visibility:public"],
)

# hadolint, which lints the Dockerfile. On macOS it is the x86-64 release,
# which runs through Rosetta.
alias(
    name = "hadolint",
    actual = select(
        {
            ":linux_arm64": "@hadolint_linux_arm64//file",
            ":linux_x86_64": "@hadolint_linux_x86_64//file",
            ":macos_arm64": "@hadolint_macos_x86_64//file",
        },
        no_match_error = _NO_PINNED_RELEASE,
    ),
    visibility = ["//visibility:public"],
)
