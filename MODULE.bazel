# checksums are the ones in the SHA256SUMS file of the release.
ETCD_BUILD_FILE = """exports_files(["etcd"], visibility = ["//visibility:public"])"""

http_archive(
    name = "etcd_macos_arm64",
    build_file_content = ETCD_BUILD_FILE,
