# protoc, which the build script of etcd-client runs. The release has no
# checksum file; these are the digests GitHub publishes for its assets.
# protoc looks for the well-known types in `include`, next to its `bin`.
PROTOC_BUILD_FILE = """
package(default_visibility = ["//visibility:public"])

exports_files(["bin/protoc"])

filegroup(
    name = "well_known_types",
    srcs = glob(["include/**/*.proto"]),
)
"""

http_archive(
    name = "protoc_macos_arm64",
    build_file_content = PROTOC_BUILD_FILE,
    sha256 = "9cd98a532c5c5e0c4161314de0225de27e4c8a323917b6ea7b1b714d3ae23466",
    urls = ["https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protoc-36.2-osx-aarch_64.zip"],
)

http_archive(
    name = "protoc_linux_x86_64",
    build_file_content = PROTOC_BUILD_FILE,
    sha256 = "121f6c7afe1d4d0e3ea6aab9432038599250134cbf4474cb1167d2c7decd4278",
    urls = ["https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protoc-36.2-linux-x86_64.zip"],
)

http_archive(
    name = "protoc_linux_arm64",
