"""bitacora: a replicated log and a materializer framework."""

module(
    name = "bitacora",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_shell", version = "0.10.0")

# The Rust toolchain is hermetic: Bazel downloads it, so local and remote
# builds use the same compiler. Keep the version in sync with
# src/rust/rust-toolchain.toml, which is what cargo and rust-analyzer read.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Third-party crates come from the Cargo workspace, so Cargo.toml and
# Cargo.lock stay the single source of truth for dependencies.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//src/rust:Cargo.lock",
    manifests = [
        "//src/rust:Cargo.toml",
        "//src/rust/bita:Cargo.toml",
        "//src/rust/bita-bench:Cargo.toml",
        "//src/rust/bita-controller:Cargo.toml",
        "//src/rust/bita-replica:Cargo.toml",
        "//src/rust/bitacora:Cargo.toml",
        "//src/rust/bitacora-artifact:Cargo.toml",
        "//src/rust/bitacora-artifact-s3:Cargo.toml",
        "//src/rust/bitacora-client:Cargo.toml",
        "//src/rust/bitacora-clusterkit:Cargo.toml",
        "//src/rust/bitacora-controller:Cargo.toml",
        "//src/rust/bitacora-kv:Cargo.toml",
        "//src/rust/bitacora-materializer:Cargo.toml",
        "//src/rust/bitacora-meta:Cargo.toml",
        "//src/rust/bitacora-meta-etcd:Cargo.toml",
        "//src/rust/bitacora-model:Cargo.toml",
        "//src/rust/bitacora-process:Cargo.toml",
        "//src/rust/bitacora-proto:Cargo.toml",
        "//src/rust/bitacora-replica:Cargo.toml",
        "//src/rust/bitacora-segment:Cargo.toml",
        "//src/rust/bitacora-sim:Cargo.toml",
        "//src/rust/bitacora-testkit:Cargo.toml",
        "//src/rust/bitacora-types:Cargo.toml",
    ],
)
# tokio's unstable API is what lets the simulator seed the runtime's own
# random choices (which waiter a watch channel wakes first, for example), so
# that a seed replays a run exactly. Cargo gets the same flag from
# src/rust/.cargo/config.toml.
crate.annotation(
    crate = "tokio",
    rustc_flags = ["--cfg=tokio_unstable"],
)

# etcd-client compiles etcd's protocol files in its build script, and that
# needs the protocol buffer compiler. Bazel hands it the pinned one below,
# so the build does not depend on what the machine has installed. The labels
# name aliases of this module, hence the `@@//` of the main repository.
crate.annotation(
    build_script_env = {"PROTOC": "$(execpath @@//src/rust:protoc)"},
    build_script_tools = [
        "@@//src/rust:protoc",
        "@@//src/rust:protoc_well_known_types",
    ],
    crate = "etcd-client",
)
use_repo(crate, "crates")

# Programs that builds and tests run, as released by their projects. Each
# archive is pinned by its checksum; //src/rust:BUILD.bazel picks the one
# for the platform. To add a platform, add its archive here and there.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# etcd, which the tests of the metadata store's etcd backend start. The
# checksums are the ones in the SHA256SUMS file of the release.
ETCD_BUILD_FILE = """exports_files(["etcd"], visibility = ["//visibility:public"])"""

http_archive(
    name = "etcd_macos_arm64",
    build_file_content = ETCD_BUILD_FILE,
    sha256 = "8a133f870071370311a031f3bfda1d4c0bbfe1d73c53e23223b0363957813d76",
    strip_prefix = "etcd-v3.6.17-darwin-arm64",
    urls = ["https://github.com/etcd-io/etcd/releases/download/v3.6.17/etcd-v3.6.17-darwin-arm64.zip"],
)

http_archive(
    name = "etcd_linux_x86_64",
    build_file_content = ETCD_BUILD_FILE,
    sha256 = "5c6365e03d0c81f605458f3f9a115f6daaebca08d1fb42d3ab0f1a38fd30909c",
    strip_prefix = "etcd-v3.6.17-linux-amd64",
    urls = ["https://github.com/etcd-io/etcd/releases/download/v3.6.17/etcd-v3.6.17-linux-amd64.tar.gz"],
)

http_archive(
    name = "etcd_linux_arm64",
    build_file_content = ETCD_BUILD_FILE,
    sha256 = "cb49ad3c3a722957c8ddfd77870539f7db89d00c2a970c014dead2cb62792814",
    strip_prefix = "etcd-v3.6.17-linux-arm64",
    urls = ["https://github.com/etcd-io/etcd/releases/download/v3.6.17/etcd-v3.6.17-linux-arm64.tar.gz"],
)

# protoc, which the build script of etcd-client runs. The release has no
# checksum file; these are the digests GitHub publishes for its assets.
# protoc looks for the well-known types in `include`, next to its `bin`.
PROTOC_BUILD_FILE = """
package(default_visibility = ["//visibility:public"])

exports_files(["bin/protoc"])

filegroup(
    name = "well_known_types",
    srcs = glob(["include/**/*.proto"]),
)
"""

http_archive(
    name = "protoc_macos_arm64",
    build_file_content = PROTOC_BUILD_FILE,
    sha256 = "9cd98a532c5c5e0c4161314de0225de27e4c8a323917b6ea7b1b714d3ae23466",
    urls = ["https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protoc-36.2-osx-aarch_64.zip"],
)

http_archive(
    name = "protoc_linux_x86_64",
    build_file_content = PROTOC_BUILD_FILE,
    sha256 = "121f6c7afe1d4d0e3ea6aab9432038599250134cbf4474cb1167d2c7decd4278",
    urls = ["https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protoc-36.2-linux-x86_64.zip"],
)

http_archive(
    name = "protoc_linux_arm64",
    build_file_content = PROTOC_BUILD_FILE,
    sha256 = "8b8f18bd2b30346efbc698dd5a73dd7c805f3ef8380f6dfc95c768f3f1852f6a",
    urls = ["https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protoc-36.2-linux-aarch_64.zip"],
)

# The Versity S3 Gateway, which the tests of the artifact store's S3 backend
# start: one program that serves a local directory over the S3 protocol. The
# checksums are the ones in the checksums.txt file of the release.
S3_SERVER_BUILD_FILE = """exports_files(["versitygw"], visibility = ["//visibility:public"])"""

http_archive(
    name = "versitygw_macos_arm64",
    build_file_content = S3_SERVER_BUILD_FILE,
    sha256 = "678555913e0eb574f38d1daef36fcc584392e9ae2bb966ee6d3d6bbab1e14c31",
    strip_prefix = "versitygw_v1.11.0_Darwin_arm64",
    urls = ["https://github.com/versity/versitygw/releases/download/v1.11.0/versitygw_v1.11.0_Darwin_arm64.tar.gz"],
)

http_archive(
    name = "versitygw_linux_x86_64",
    build_file_content = S3_SERVER_BUILD_FILE,
    sha256 = "1f075c9dc92fef232f5b3c7465711ddc5e1b062b2b6df4a3bd246a4be5b35b52",
    strip_prefix = "versitygw_v1.11.0_Linux_x86_64",
    urls = ["https://github.com/versity/versitygw/releases/download/v1.11.0/versitygw_v1.11.0_Linux_x86_64.tar.gz"],
)

http_archive(
    name = "versitygw_linux_arm64",
    build_file_content = S3_SERVER_BUILD_FILE,
    sha256 = "8bd88019511c288de3ce2e5f0efb86f4092a98f7067371a1a8fa461ec0cc161b",
    strip_prefix = "versitygw_v1.11.0_Linux_arm64",
    urls = ["https://github.com/versity/versitygw/releases/download/v1.11.0/versitygw_v1.11.0_Linux_arm64.tar.gz"],
