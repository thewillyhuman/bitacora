    strip_prefix = "etcd-v3.6.17-darwin-arm64",
    urls = ["https://github.com/etcd-io/etcd/releases/download/v3.6.17/etcd-v3.6.17-darwin-arm64.zip"],
)

http_archive(
    name = "etcd_linux_x86_64",
