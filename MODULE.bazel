"""bitacora: a replicated log and a materializer framework."""

module(
    name = "bitacora",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

# Builds the C programs that test the client's C interface. The version is
# the one rules_rust already brings in.
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_shell", version = "0.10.0")

# The Rust toolchain is hermetic: Bazel downloads it, so local and remote
# builds use the same compiler. Keep the version in sync with
# src/rust/rust-toolchain.toml, which is what cargo and rust-analyzer read.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Third-party crates come from the Cargo workspace, so Cargo.toml and
# Cargo.lock stay the single source of truth for dependencies.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//src/rust:Cargo.lock",
    manifests = [
        "//src/rust:Cargo.toml",
        "//src/rust/bita:Cargo.toml",
        "//src/rust/bita-bench:Cargo.toml",
        "//src/rust/bita-controller:Cargo.toml",
        "//src/rust/bita-replica:Cargo.toml",
        "//src/rust/bitacora:Cargo.toml",
        "//src/rust/bitacora-artifact:Cargo.toml",
        "//src/rust/bitacora-artifact-s3:Cargo.toml",
        "//src/rust/bitacora-c:Cargo.toml",
        "//src/rust/bitacora-client:Cargo.toml",
        "//src/rust/bitacora-clusterkit:Cargo.toml",
        "//src/rust/bitacora-controller:Cargo.toml",
        "//src/rust/bitacora-kv:Cargo.toml",
        "//src/rust/bitacora-materializer:Cargo.toml",
        "//src/rust/bitacora-meta:Cargo.toml",
        "//src/rust/bitacora-meta-etcd:Cargo.toml",
        "//src/rust/bitacora-model:Cargo.toml",
        "//src/rust/bitacora-process:Cargo.toml",
        "//src/rust/bitacora-proto:Cargo.toml",
        "//src/rust/bitacora-replica:Cargo.toml",
        "//src/rust/bitacora-segment:Cargo.toml",
        "//src/rust/bitacora-sim:Cargo.toml",
        "//src/rust/bitacora-testkit:Cargo.toml",
        "//src/rust/bitacora-types:Cargo.toml",
    ],
)
# tokio's unstable API is what lets the simulator seed the runtime's own
# random choices (which waiter a watch channel wakes first, for example), so
# that a seed replays a run exactly. Cargo gets the same flag from
# src/rust/.cargo/config.toml.
crate.annotation(
    crate = "tokio",
    rustc_flags = ["--cfg=tokio_unstable"],
)

# etcd-client compiles etcd's protocol files in its build script, and that
# needs the protocol buffer compiler. Bazel hands it the pinned one below,
# so the build does not depend on what the machine has installed. The labels
# name aliases of this module, hence the `@@//` of the main repository.
crate.annotation(
    build_script_env = {"PROTOC": "$(execpath @@//src/rust:protoc)"},
    build_script_tools = [
        "@@//src/rust:protoc",
        "@@//src/rust:protoc_well_known_types",
    ],
    crate = "etcd-client",
)
use_repo(crate, "crates")

# Programs that builds and tests run, as released by their projects. Each
# archive is pinned by its checksum; //src/rust:BUILD.bazel picks the one
# for the platform. To add a platform, add its archive here and there.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

