"""The documentation. Files that tests read are exported here."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//hack/tools:defs.bzl", "shellcheck_test")

# The index is written by hand, so a test compares it with the files.
sh_test(
    name = "index_test",
    size = "small",
    srcs = ["index_test.sh"],
    data = glob(["**/*.md"]),
)

shellcheck_test(
    name = "shellcheck_test",
    srcs = ["index_test.sh"],
)

# These are checked against the code, so that they cannot fall behind it:
# the metrics reference by the test of every crate that registers metrics
# and by the tests of the alert rules and of the dashboard, the page about
# the alerts by the test of the rules, the command reference by the tests
# of the `bita` tool, the C client's example by the test that compiles and
# runs it.
exports_files(
    [
        "cli.md",
        "clients/c.md",
        "operations/alerts.md",
        "operations/metrics.md",
    ],
    visibility = ["//visibility:public"],
)

# The Go client's page is compared with the example it shows, which is a
# program the Go tests compile and run.
exports_files(
    ["clients/go.md"],
    visibility = ["//src/go:__subpackages__"],
)
